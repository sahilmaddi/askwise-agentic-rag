# Copy to .env and pick one provider per layer. Docker Compose reads this file automatically.

# Generation: ollama (local, default) | openai | azure | mistral | extractive (no model)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:1b

# Embeddings: fastembed (local Hugging Face model, default) | openai | azure | cohere | hashing (no model)
EMBEDDINGS_PROVIDER=fastembed
EMBEDDINGS_MODEL=

# Vector store: faiss (default) | memory | milvus | azure_search
VECTOR_STORE=faiss

# Keys for whichever cloud providers you select
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
